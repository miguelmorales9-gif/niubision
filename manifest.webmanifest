{
  "id": "https://niubision.com/pwa",
  "name": "NiuBision",
  "short_name": "NiuBision",
  "description": "Entrenamiento personal y coaching en línea en Puerto Rico. Niubi + visión. See the work. Enjoy the day.",
  "start_url": "https://niubision.com/?source=pwa",
  "scope": "https://niubision.com/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#121018",
  "theme_color": "#121018",
  "lang": "es",
  "dir": "ltr",
  "categories": ["health", "fitness", "lifestyle"],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://niubision.com/manifest.webmanifest"
    }
  ],
  "shortcuts": [
    {
      "name": "Hoy",
      "short_name": "Hoy",
      "url": "https://niubision.com/?source=pwa",
      "icons": [{ "src": "https://niubision.com/icon-192.png?v=and2", "sizes": "192x192" }]
    },
    {
      "name": "Planes",
      "short_name": "Planes",
      "url": "https://niubision.com/?view=price",
      "icons": [{ "src": "https://niubision.com/icon-192.png?v=and2", "sizes": "192x192" }]
    },
    {
      "name": "Bandeja",
      "short_name": "Bandeja",
      "url": "https://niubision.com/?view=inbox",
      "icons": [{ "src": "https://niubision.com/icon-192.png?v=and2", "sizes": "192x192" }]
    }
  ],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "handle_links": "preferred",
  "icons": [
    { "src": "https://niubision.com/icon-48.png?v=and2", "sizes": "48x48", "type": "image/png", "purpose": "any" },
    { "src": "https://niubision.com/icon-72.png?v=and2", "sizes": "72x72", "type": "image/png", "purpose": "any" },
    { "src": "https://niubision.com/icon-96.png?v=and2", "sizes": "96x96", "type": "image/png", "purpose": "any" },
    { "src": "https://niubision.com/icon-144.png?v=and2", "sizes": "144x144", "type": "image/png", "purpose": "any" },
    { "src": "https://niubision.com/icon-192.png?v=and2", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "https://niubision.com/icon-512.png?v=and2", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "https://niubision.com/icon-192-maskable.png?v=and2", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "https://niubision.com/icon-512-maskable.png?v=and2", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
